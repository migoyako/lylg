<%- include('../partials/header') %>
<section class="page-heading">
  <div>
    <p class="eyebrow">BOOK CATALOG</p>
    <h1>图书借阅系统-后台管理</h1>
  </div>
  <a class="button button-secondary" href="/books/new?returnTo=<%= encodeURIComponent(editReturnTo) %>">新增图书</a>
</section>

<% if (notice) { %>
  <div class="notice notice-<%= notice.type %>" role="status" data-auto-dismiss><%= notice.text %></div>
<% } %>

<form class="search-bar" method="get" action="/books" role="search">
  <label for="book-name">图书名称</label>
  <input id="book-name" name="name" type="search" value="<%= name %>" maxlength="100" placeholder="输入图书名称进行模糊查询">
  <button class="button button-primary" type="submit">查询</button>
  <% if (name) { %>
    <a class="text-link" href="/books">清除条件</a>
  <% } %>
</form>

<div class="table-frame">
  <table class="book-table">
    <thead>
      <tr>
        <th scope="col">图书编号</th>
        <th scope="col">图书分类</th>
        <th scope="col">图书名称</th>
        <th scope="col">作者</th>
        <th scope="col">出版社</th>
        <th scope="col">入库时间</th>
        <th scope="col">是否借阅</th>
        <th scope="col">操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (items.length === 0) { %>
        <tr>
          <td class="empty-state" colspan="8">没有找到符合条件的图书信息</td>
        </tr>
      <% } %>
      <% items.forEach((book) => { %>
        <tr>
          <td><%= book.bookCode %></td>
          <td><%= book.typeName %></td>
          <td class="book-name"><%= book.bookName %></td>
          <td><%= book.bookAuthor %></td>
          <td><%= book.publishPress %></td>
          <td><%= formatDate(book.creationTime) %></td>
          <td>
            <span class="status status-<%= book.borrowed ? 'borrowed' : 'available' %>">
              <%= book.borrowed ? '已借阅' : '未借阅' %>
            </span>
          </td>
          <td class="actions">
            <a href="/books/<%= book.bookId %>?returnTo=<%= encodeURIComponent(editReturnTo) %>">查看</a>
            <a href="/books/<%= book.bookId %>/edit?returnTo=<%= encodeURIComponent(editReturnTo) %>">修改</a>
            <form method="post" action="/books/<%= book.bookId %>/delete" class="inline-form" data-confirm="确定删除该图书信息？">
              <input type="hidden" name="returnTo" value="<%= editReturnTo %>">
              <button type="submit" class="link-button danger">删除</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<nav class="pagination" aria-label="图书列表分页">
  <span>共 <%= total %> 条，第 <%= page %> / <%= totalPages %> 页</span>
  <div class="pagination-actions">
    <% if (page > 1) { %>
      <a href="/books?<%= queryString %>&page=<%= page - 1 %>">上一页</a>
    <% } else { %>
      <span class="disabled">上一页</span>
    <% } %>

    <% for (let current = 1; current <= totalPages; current += 1) { %>
      <a class="<%= current === page ? 'current' : '' %>" href="/books?<%= queryString %>&page=<%= current %>" aria-current="<%= current === page ? 'page' : 'false' %>"><%= current %></a>
    <% } %>

    <% if (page < totalPages) { %>
      <a href="/books?<%= queryString %>&page=<%= page + 1 %>">下一页</a>
    <% } else { %>
      <span class="disabled">下一页</span>
    <% } %>
  </div>
  <form class="page-jump" method="get" action="/books">
    <input type="hidden" name="name" value="<%= name %>">
    <label for="page-number">跳至</label>
    <input id="page-number" name="page" type="number" min="1" max="<%= totalPages %>" value="<%= page %>" inputmode="numeric">
    <span>页</span>
    <button type="submit" class="button button-small">确定</button>
  </form>
</nav>
<%- include('../partials/footer') %>
